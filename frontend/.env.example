# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Configuration  
NEXT_PUBLIC_APP_NAME=Atlassian Connect Dashboard
NEXT_PUBLIC_APP_VERSION=1.0.0

# OAuth Configuration (handled by backend)
# These are configured in the backend service
# ATLASSIAN_CLIENT_ID=your_client_id
# ATLASSIAN_CLIENT_SECRET=your_client_secret
# ATLASSIAN_REDIRECT_URI=http://localhost:3000/auth/callback

# Environment
NODE_ENV=development
